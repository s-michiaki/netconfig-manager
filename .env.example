# cp .env.example .env して値を設定してください（.env は Git にコミットしないこと）

# PostgreSQL のパスワード
# ※ 既存の postgres_data ボリュームがある場合は、初回作成時のパスワード（以前のデフォルトは changeme）を設定すること
POSTGRES_PASSWORD=

# JWT 署名鍵（32文字以上）
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# 機器パスワード暗号化キー（Fernet）。紛失すると登録済みの機器パスワードを復号できなくなるので必ず控えておくこと
#   python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
#   （cryptography が無い場合: python3 -c "import base64,os; print(base64.urlsafe_b64encode(os.urandom(32)).decode())"）
DEVICE_ENCRYPTION_KEY=

# 初回起動時（ユーザーが1人もいないとき）に作成する管理者
# ADMIN_PASSWORD を空にすると、ランダムなパスワードを生成して backend の起動ログに一度だけ表示します
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# SSH ホスト鍵の検証方式
#   tofu  : 初回接続時に鍵を記録し、以後は一致を検証（鍵が変わったら接続拒否）
#   strict: known_hosts に登録済みのホストのみ接続
SSH_HOST_KEY_POLICY=tofu

# 機器の応答待ち時間の既定値（秒, 10〜600）。ログイン後のプロンプト待ち・コマンド実行の待ちの上限
# 応答の遅い機器だけ延ばす場合は、デバイス設定の「応答待ち時間」で個別に指定する
SSH_READ_TIMEOUT=120

# 監査ログの保持日数（0 なら削除しない）。毎日1回、古いものを削除します
#   AUDIT_LOG_RETENTION_DAYS    : 操作履歴（ログイン・機器の変更など）
#   TERMINAL_LOG_RETENTION_DAYS : ターミナルの画面出力の記録
AUDIT_LOG_RETENTION_DAYS=365
TERMINAL_LOG_RETENTION_DAYS=180
# ターミナルの記録を DEVICE_ENCRYPTION_KEY で暗号化して保存する（false で平文）
TERMINAL_LOG_ENCRYPT=true
# ターミナルの記録を、読める形のテキスト（色や制御文字を除いたもの）でも保存する（監査ログで読む・検索する・渡すため）
TERMINAL_LOG_TEXT=true

# ログインの失敗回数の制限（0 で制限しない）
#   LOGIN_MAX_FAILURES        : 同じユーザー名・同じ接続元からの失敗の上限
#   LOGIN_MAX_FAILURES_PER_IP : 同じ接続元からの失敗の上限（ユーザー名を問わない）
#   LOGIN_FAILURE_WINDOW_MIN  : 失敗を数える期間（分）
#   LOGIN_LOCK_MIN            : 上限に達したときにログインを止める時間（分）
LOGIN_MAX_FAILURES=5
LOGIN_MAX_FAILURES_PER_IP=20
LOGIN_FAILURE_WINDOW_MIN=10
LOGIN_LOCK_MIN=15

# API トークン（スクリプト・ほかのシステムから API を使うための、本人が発行するトークン）
#   API_TOKENS_ENABLED : false にすると、新しい発行も、発行済みのトークンでの API の利用もできなくなる
#   API_TOKEN_MAX_DAYS : 発行するときに選べる期限の上限（日。1〜365）
API_TOKENS_ENABLED=true
API_TOKEN_MAX_DAYS=365

# 収集失敗の通知をまとめる時間（秒）。最初の失敗からこの時間に起きた失敗を、通知先ごとに 1 通にまとめる
# （ネットワーク障害などで多数の機器が同時に失敗しても通知があふれないように）。0 なら機器ごとにすぐ通知する
NOTIFY_FAILURE_BATCH_SEC=60
# 変更の確認（画面「変更の確認」・ダッシュボードの「未確認の変更」）で、未確認の変更を数える期間（日数。1〜365）
CHANGE_REVIEW_DAYS=30

# システムの状態の確認と異常の通知（画面「システム状態」。通知設定で「システムの異常」を選んだ通知先へ送る）
#   SYSTEM_WATCHDOG_ENABLED : false で異常の通知を止める（画面での確認はできる）
#   SYSTEM_ALERT_AFTER_MIN  : worker・スケジューラー・Redis の停止がこの分数続いたら通知する
#   SYSTEM_STALE_DAYS       : この日数以上収集できていない有効な機器を警告する（0 で確認しない）
#   BACKUP_STALE_HOURS      : 最後のバックアップの成功からこの時間を過ぎたら警告する（0 で確認しない）。
#                             BACKUP_ON_CALENDAR を週 1 回などにしたら、間隔より長く（例: 週 1 回なら 192）する
#   IMAGE_STALE_DAYS        : コンテナのイメージがこの日数より前に作られたものなら警告する（setup.sh で取り直していない。0 で確認しない）
SYSTEM_WATCHDOG_ENABLED=true
SYSTEM_ALERT_AFTER_MIN=10
SYSTEM_STALE_DAYS=7
BACKUP_STALE_HOURS=36
IMAGE_STALE_DAYS=60
# コンフィグ検索（CSV 出力も）の同時実行数: 1 人あたり・全体
SEARCH_MAX_PER_USER=2
SEARCH_MAX_CONCURRENT=4

# コンプライアンスの正規表現の照合にかけられる時間（1回の評価＝ルール × 機器 あたりの秒数）
COMPLIANCE_REGEX_TIMEOUT=2

# 再検査で同時に照合するスレッドの数（プロセスごと。多いほど速いが、CPU を取り合う）
COMPLIANCE_CHECK_CONCURRENCY=2

# 収集時に無視する行（正規表現）にかけられる時間（秒）。1 ルールあたりと、全ルールの合計。超えたらその回のコンフィグは保存せず、収集の失敗（再試行あり）にする
IGNORE_RULE_TIMEOUT=1
IGNORE_TOTAL_TIMEOUT=5

# アクティビティログ（収集の結果・違反の発生など、システムで起きたこと）
#   ACTIVITY_LOG_RETENTION_DAYS : 保持日数（0 なら削除しない）
#   ACTIVITY_LOG_UNCHANGED      : 収集で変更が無かったときも記録するか（false で変更あり・失敗などだけ）
ACTIVITY_LOG_RETENTION_DAYS=90
ACTIVITY_LOG_UNCHANGED=true

# Ping監視
#   PING_TIMEOUT     : 1回の PING の応答待ち（秒）。監視間隔より長い場合は間隔に合わせて短くなります
#   PING_MAX_TARGETS : 1画面で同時に監視できる対象数の上限
PING_TIMEOUT=1
PING_MAX_TARGETS=300
# 常時監視（画面の「常時監視」に加えた対象を、画面を開いていなくても worker が PING する）
#   PING_MONITOR_INTERVAL_SEC : PING する間隔（秒。10〜3600）
#   PING_ALERT_AFTER          : この回数続けて応答が無ければ「応答なし」として通知（復旧は 1 回の応答で通知）
#   PING_HISTORY_DAYS         : 結果を残す日数
PING_MONITOR_INTERVAL_SEC=60
PING_ALERT_AFTER=3
PING_HISTORY_DAYS=14

# --- 定期レポート（通知設定の「定期レポート」。週次は月曜・月次は 1 日に、この時刻（TIMEZONE）以降の最初の判定で送る） ---
#   REPORT_HOUR : 送る時刻（0〜23）
REPORT_HOUR=8

# --- コンフィグ履歴を外部の Git サーバー（GitLab / Gitea など）へ push する（GIT_EXPORT_URL が空なら無効） ---
# 相手に空のリポジトリを作っておき、その URL を書く。各機器の最新コンフィグを「グループ/機器名.txt」として送り、
# 収集でコンフィグが変わったら GIT_EXPORT_DELAY_SEC 秒後（その間の変更はまとめる）と、1 時間ごとに push する
#   GIT_EXPORT_URL      : 例 https://gitlab.example.local/net/configs.git / git@gitea.local:net/configs.git
#                         （認証情報は URL に書かず GIT_EXPORT_USERNAME / GIT_EXPORT_TOKEN に。書くと「システム状態」で注意）
#                         （HTTPS の URL にパスワードやトークンを書かない。下の USERNAME / TOKEN を使う）
#   GIT_EXPORT_BRANCH   : push するブランチ（既定 main）
#   GIT_EXPORT_USERNAME : HTTPS のユーザー名（GitLab のプロジェクトアクセストークンなら空のまま = oauth2）
#   GIT_EXPORT_TOKEN    : HTTPS のアクセストークン（write_repository など push できる権限）
#   GIT_EXPORT_SSH_KEY  : SSH の秘密鍵（コンテナの中のパス。例 /data/ssh/git_export_key。README 参照）
#   GIT_EXPORT_CA_FILE  : 社内の CA で発行した証明書の Git サーバーなら、その CA 証明書（コンテナの中のパス）
#   GIT_EXPORT_DELAY_SEC: 収集で変わってから push するまでの秒数
GIT_EXPORT_URL=
GIT_EXPORT_BRANCH=main
GIT_EXPORT_USERNAME=
GIT_EXPORT_TOKEN=
GIT_EXPORT_SSH_KEY=
GIT_EXPORT_CA_FILE=
GIT_EXPORT_DELAY_SEC=60

# 2 段階認証: 認証アプリに表示する名前（複数のサーバーで使うときは区別できる名前にする）
# MFA_ISSUER=NetConfig Manager

# 機器台帳の自動取得
#   INVENTORY_ENABLED : true なら、収集のついでに show version などを実行して、モデル・シリアル番号・
#                       OS バージョンを読み取る。機器に追加のコマンドを送りたくない場合は false
INVENTORY_ENABLED=true

# 保存し忘れの検出（startup-config と running-config の不一致）
#   STARTUP_CHECK_ENABLED : true なら、収集のついでに show startup-config を実行して running-config と比べる
#                           （Cisco IOS / IOS-XE / NX-OS・Arista EOS・AlliedWare Plus のみ）。送りたくない場合は false
STARTUP_CHECK_ENABLED=true
#   STARTUP_CHECK_TIMEOUT : show startup-config の応答待ち（秒、5〜600）。機器の応答待ち時間が短ければそちら。待っても読めなければ状態は「不明」
STARTUP_CHECK_TIMEOUT=30

# コマンド実行（表示コマンドの一括実行。show / display など設定を変えないコマンドだけ送れる）
#   COMMAND_RUN_ENABLED         : false にすると、コマンド実行の新しい実行を受け付けない（過去の結果は見られる）
#   COMMAND_RUN_MAX_DEVICES     : 1 回の実行で対象にできる機器の数（1〜1000）
#   COMMAND_RUN_CONCURRENCY     : 1 回の実行の中で、同時に接続する機器の数（1〜100）
#   COMMAND_RUN_MAX_OUTPUT      : 1 コマンドの出力の上限（文字数）。超えた分は切り捨てる
#   COMMAND_RUN_MAX_RUN_OUTPUT  : 1 回の実行の出力の合計の上限（文字数）。超えた分は切り捨てる
#   COMMAND_RUN_MAX_ACTIVE_PER_USER : 1 人が同時に動かせる実行（終わっていないもの）の数。超えたら新しい実行を断る（429）
#   COMMAND_RUN_MAX_ACTIVE      : 全体で同時に動かせる実行の数
#   COMMAND_RUN_RETENTION_DAYS  : 実行結果（出力）を残す日数。過ぎたものは毎日の掃除で消す
COMMAND_RUN_ENABLED=true
COMMAND_RUN_MAX_DEVICES=100
COMMAND_RUN_CONCURRENCY=10
COMMAND_RUN_MAX_OUTPUT=200000
COMMAND_RUN_MAX_RUN_OUTPUT=20000000
COMMAND_RUN_MAX_ACTIVE_PER_USER=2
COMMAND_RUN_MAX_ACTIVE=5
COMMAND_RUN_RETENTION_DAYS=30

# モニタリング（試験導入。帯域の使用率・FW ルールのヒット数）
#   MONITORING_ENABLED      : true で画面・定期取得を有効にする（変更後は setup.sh でコンテナを作り直す）
#   MONITOR_INTERVAL_SEC    : SNMP で帯域を取得する間隔（秒）
#   MONITOR_RETENTION_DAYS  : 帯域の記録の保存日数
#   MONITOR_FW_INTERVAL_MIN : FW のルールのヒット数を取得する間隔（分。SSH でログインして取得）
#   MONITOR_PANOS_VSYS      : Palo Alto でヒット数を取得する vsys
MONITORING_ENABLED=false
MONITOR_INTERVAL_SEC=300
MONITOR_RETENTION_DAYS=30
MONITOR_FW_INTERVAL_MIN=60
MONITOR_PANOS_VSYS=vsys1

# 脆弱性（CVE）とサポート終了日の管理（既定は無効。有効にすると、毎日 1 回、サーバーから外部（下の宛先）へ HTTPS で接続する）
#   VULN_ENABLED     : true で画面（メニュー「監視」の「脆弱性・サポート期限」）と定期取得を有効にする（変更後は setup.sh でコンテナを作り直す）
#   VULN_FETCH_HOUR  : 毎日この時刻（0〜23。TIMEZONE）以降の最初の判定で取得する
#   VULN_SOURCES     : 使う情報源（カンマ区切り）。paloalto=Palo Alto の勧告 / fortinet=Fortinet の勧告（FortiOS）/
#                      kev=CISA の悪用確認済み一覧 / eol=サポート終了日（endoflife.date）
#   つなぐ宛先: security.paloaltonetworks.com・filestore.fortinet.com・www.fortiguard.com（過去の勧告の取り込みのときだけ）・
#              www.cisa.gov・endoflife.date（443 番）。機器名・IP・OS バージョンは送らない
#   プロキシを通すときは、下の「外部への接続」の OUTBOUND_PROXY を使う
VULN_ENABLED=false
VULN_FETCH_HOUR=4
VULN_SOURCES=paloalto,fortinet,kev,eol

# 外部への接続（インターネットへの HTTPS。Discord・Slack・Teams の Webhook、メールの OAuth 2.0 のトークンの取得、脆弱性情報の取得）
# 直接インターネットへ出られない環境で、プロキシを通す・組織の CA を信頼するときに設定する。空なら今までどおり直接つなぐ
# 外部 Git（GIT_EXPORT_URL が https:// のとき）もプロキシを通す。SMTP（メールの送信そのもの）・機器への SSH・踏み台・SSH の外部 Git・DB・Redis は通さない
#   OUTBOUND_PROXY    : http://ホスト:ポート、認証が要るなら http://ユーザー:パスワード@ホスト:ポート（例: http://proxy.example.test:3128）
#                       http:// だけ。ポートは必須（https://・socks のプロキシ・ポートの無い値・不正な値は起動時にエラー。値はエラーに出さない）
#                       ユーザー名・パスワードの記号は URL エンコードで書く（@ → %40、: → %3A、% → %25、# → %23、/ → %2F）
#                       例: ユーザー user01・パスワード p@ss:word → http://user01:p%40ss%3Aword@proxy.example.test:8080
#                       ユーザー名だけ（http://user01@…）は起動時にエラー。パスワードが空なら http://user01:@proxy.example.test:8080
#                       プロキシとの間は暗号化されない（宛先との通信は CONNECT のトンネルの中で TLS により保護される）。
#                       認証情報（Basic 認証）はプロキシまでの区間を平文で流れるので、信頼できる社内の経路でだけ使う
#                       環境変数の HTTPS_PROXY・NO_PROXY は見ない（ここの設定だけを使う）
#   OUTBOUND_NO_PROXY : プロキシを通さない宛先（カンマ区切り。ホスト名・ドメイン（example.test で配下も含む）・IP・CIDR。* はすべて直接）
#                       例: intranet.example.test,.corp.example.test,10.0.0.0/8。localhost・コンテナ名（db・redis など）は書かなくても直接
#                       ポートつき・途中に * を含む書き方・日本語のドメイン（punycode で書く）は不可。*.example.test は .example.test と同じ
#   OUTBOUND_CA_FILE  : 追加で信頼する CA 証明書（PEM。HTTPS の中身を検査するプロキシの CA など）のファイルの名前
#                       ファイルは certs-outbound/ に置く（例: /opt/netconfig-manager/certs-outbound/outbound-ca.pem → outbound-ca.pem）
#                       OS の既定の信頼に「足す」だけで、証明書の検証は弱めない。読めない・PEM でない・証明書が無いと起動時にエラー
OUTBOUND_PROXY=
OUTBOUND_NO_PROXY=
OUTBOUND_CA_FILE=

# 利用者がブラウザで開く URL（例: https://192.168.1.10 / https://netconfig.example.local）
# コンフィグ変更の通知（Discord / Slack / Teams）に画面へのリンクを付けるのに使う。空ならリンクなし
# setup.sh・import_cert.sh が未設定のときに IP アドレスから自動で設定します
PUBLIC_URL=

# 別オリジンからAPIを呼ぶ場合のみ設定（カンマ区切り）。通常は空でよい
ALLOWED_ORIGINS=

# 本番構成で公開する HTTP ポート
HTTP_PORT=80
# 本番構成で公開する HTTPS ポート（certs/ に証明書があるときだけ使われる。scripts/import_cert.sh 参照）
HTTPS_PORT=443

# バックアップ（scripts/backup.sh。setup.sh が systemd タイマーで毎日実行するよう登録）
# 保存先（サーバーの外のディスク・NFS などを推奨）
BACKUP_DIR=/var/backups/netconfig-manager
# 保存日数
BACKUP_KEEP_DAYS=14
# 実行時刻（systemd の OnCalendar 形式。off で無効。変更後は setup.sh を実行）
BACKUP_ON_CALENDAR=*-*-* 03:15:00
# ターミナルの記録も含める
BACKUP_TERMINAL_LOGS=true
#
# ---- サーバー外への保管（ここから下と上の BACKUP_* は、ホストの backup.sh だけが読む。コンテナには渡さない）
# ※ バックアップには .env（DEVICE_ENCRYPTION_KEY）と証明書の秘密鍵が入っている。手に入れた人は機器のパスワードを
#   復号できるため、コピー先は root 相当の人だけが読める場所にすること（コピー先のディレクトリも 700 に。
#   NFS は root_squash と export する相手の制限、SMB は専用のアカウント）
# コピー先（NAS などをマウントした場所。空ならコピーしない）。失敗してもサーバー内のバックアップは残り、画面と通知で知らせる
BACKUP_COPY_DIR=
# true: コピー先が BACKUP_DIR・/ と別のディスク（マウントしたもの）でなければコピーしない（マウントが外れたときに
#       サーバーのディスクへ書いてしまうのを防ぐ）。同じディスクの別の場所へ置くのが意図した構成なら false
BACKUP_COPY_REQUIRE_MOUNT=true
# コピー先の保存日数（空なら BACKUP_KEEP_DAYS と同じ）
BACKUP_COPY_KEEP_DAYS=
# 作成後に実行するコマンド（rsync・scp など。作ったファイルのパスは $BACKUP_FILE。root で実行し、1 時間で打ち切る）
#   例: BACKUP_POST_COMMAND=rsync -t "$BACKUP_FILE" backup@nas.example.local:/volume1/netconfig/
BACKUP_POST_COMMAND=
# バックアップの暗号化（gpg の AES256。空なら暗号化しない）。パスフレーズを書いたファイルのパスを指定する。
#   作り方: openssl rand -base64 32 > /root/netconfig-backup.pass && chmod 600 /root/netconfig-backup.pass
#   ※ このファイルが無いと復元できない。サーバーとバックアップのコピー先とは別の場所（パスワード管理ツールなど）にも保管する
#   ※ 外部へ保管する（BACKUP_COPY_DIR・BACKUP_POST_COMMAND）のに暗号化しないと、「システム状態」で注意を出す
BACKUP_ENCRYPT_PASSPHRASE_FILE=

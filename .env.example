# cp .env.example .env して値を設定してください（.env は Git にコミットしないこと）

# PostgreSQL のパスワード
# ※ 既存の postgres_data ボリュームがある場合は、初回作成時のパスワード（以前のデフォルトは changeme）を設定すること
POSTGRES_PASSWORD=

# JWT 署名鍵（32文字以上）
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# 機器パスワード暗号化キー（Fernet）。紛失すると登録済みの機器パスワードを復号できなくなるので必ず控えておくこと
#   python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
#   （cryptography が無い場合: python3 -c "import base64,os; print(base64.urlsafe_b64encode(os.urandom(32)).decode())"）
DEVICE_ENCRYPTION_KEY=

# 初回起動時（ユーザーが1人もいないとき）に作成する管理者
# ADMIN_PASSWORD を空にすると、ランダムなパスワードを生成して backend の起動ログに一度だけ表示します
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# SSH ホスト鍵の検証方式
#   tofu  : 初回接続時に鍵を記録し、以後は一致を検証（鍵が変わったら接続拒否）
#   strict: known_hosts に登録済みのホストのみ接続
SSH_HOST_KEY_POLICY=tofu

# 機器の応答待ち時間の既定値（秒, 10〜600）。ログイン後のプロンプト待ち・コマンド実行の待ちの上限
# 応答の遅い機器だけ延ばす場合は、デバイス設定の「応答待ち時間」で個別に指定する
SSH_READ_TIMEOUT=120

# 監査ログの保持日数（0 なら削除しない）。毎日1回、古いものを削除します
#   AUDIT_LOG_RETENTION_DAYS    : 操作履歴（ログイン・機器の変更など）
#   TERMINAL_LOG_RETENTION_DAYS : ターミナルの画面出力の記録
AUDIT_LOG_RETENTION_DAYS=365
TERMINAL_LOG_RETENTION_DAYS=180

# Ping監視
#   PING_TIMEOUT     : 1回の PING の応答待ち（秒）。監視間隔より長い場合は間隔に合わせて短くなります
#   PING_MAX_TARGETS : 1画面で同時に監視できる対象数の上限
PING_TIMEOUT=1
PING_MAX_TARGETS=300

# 別オリジンからAPIを呼ぶ場合のみ設定（カンマ区切り）。通常は空でよい
ALLOWED_ORIGINS=

# 本番構成で公開する HTTP ポート
HTTP_PORT=80
# 本番構成で公開する HTTPS ポート（certs/ に証明書があるときだけ使われる。scripts/import_cert.sh 参照）
HTTPS_PORT=443

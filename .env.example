# cp .env.example .env して値を設定してください（.env は Git にコミットしないこと）

# PostgreSQL のパスワード
# ※ 既存の postgres_data ボリュームがある場合は、初回作成時のパスワード（以前のデフォルトは changeme）を設定すること
POSTGRES_PASSWORD=

# JWT 署名鍵（32文字以上）
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# 機器パスワード暗号化キー（Fernet）。紛失すると登録済みの機器パスワードを復号できなくなるので必ず控えておくこと
#   python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
#   （cryptography が無い場合: python3 -c "import base64,os; print(base64.urlsafe_b64encode(os.urandom(32)).decode())"）
DEVICE_ENCRYPTION_KEY=

# 初回起動時（ユーザーが1人もいないとき）に作成する管理者
# ADMIN_PASSWORD を空にすると、ランダムなパスワードを生成して backend の起動ログに一度だけ表示します
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# SSH ホスト鍵の検証方式
#   tofu  : 初回接続時に鍵を記録し、以後は一致を検証（鍵が変わったら接続拒否）
#   strict: known_hosts に登録済みのホストのみ接続
SSH_HOST_KEY_POLICY=tofu

# 別オリジンからAPIを呼ぶ場合のみ設定（カンマ区切り）。通常は空でよい
ALLOWED_ORIGINS=

# 本番構成で公開する HTTP ポート
HTTP_PORT=80

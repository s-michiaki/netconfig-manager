# cp .env.example .env して値を設定してください（.env は Git にコミットしないこと）

# PostgreSQL のパスワード
# ※ 既存の postgres_data ボリュームがある場合は、初回作成時のパスワード（以前のデフォルトは changeme）を設定すること
POSTGRES_PASSWORD=

# JWT 署名鍵（32文字以上）
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# 機器パスワード暗号化キー（Fernet）。紛失すると登録済みの機器パスワードを復号できなくなるので必ず控えておくこと
#   python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
#   （cryptography が無い場合: python3 -c "import base64,os; print(base64.urlsafe_b64encode(os.urandom(32)).decode())"）
DEVICE_ENCRYPTION_KEY=

# 初回起動時（ユーザーが1人もいないとき）に作成する管理者
# ADMIN_PASSWORD を空にすると、ランダムなパスワードを生成して backend の起動ログに一度だけ表示します
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# SSH ホスト鍵の検証方式
#   tofu  : 初回接続時に鍵を記録し、以後は一致を検証（鍵が変わったら接続拒否）
#   strict: known_hosts に登録済みのホストのみ接続
SSH_HOST_KEY_POLICY=tofu

# 機器の応答待ち時間の既定値（秒, 10〜600）。ログイン後のプロンプト待ち・コマンド実行の待ちの上限
# 応答の遅い機器だけ延ばす場合は、デバイス設定の「応答待ち時間」で個別に指定する
SSH_READ_TIMEOUT=120

# 監査ログの保持日数（0 なら削除しない）。毎日1回、古いものを削除します
#   AUDIT_LOG_RETENTION_DAYS    : 操作履歴（ログイン・機器の変更など）
#   TERMINAL_LOG_RETENTION_DAYS : ターミナルの画面出力の記録
AUDIT_LOG_RETENTION_DAYS=365
TERMINAL_LOG_RETENTION_DAYS=180
# ターミナルの記録を DEVICE_ENCRYPTION_KEY で暗号化して保存する（false で平文）
TERMINAL_LOG_ENCRYPT=true

# ログインの失敗回数の制限（0 で制限しない）
#   LOGIN_MAX_FAILURES        : 同じユーザー名・同じ接続元からの失敗の上限
#   LOGIN_MAX_FAILURES_PER_IP : 同じ接続元からの失敗の上限（ユーザー名を問わない）
#   LOGIN_FAILURE_WINDOW_MIN  : 失敗を数える期間（分）
#   LOGIN_LOCK_MIN            : 上限に達したときにログインを止める時間（分）
LOGIN_MAX_FAILURES=5
LOGIN_MAX_FAILURES_PER_IP=20
LOGIN_FAILURE_WINDOW_MIN=10
LOGIN_LOCK_MIN=15

# システムの状態の確認と異常の通知（画面「システム状態」。通知設定で「システムの異常」を選んだ通知先へ送る）
#   SYSTEM_WATCHDOG_ENABLED : false で異常の通知を止める（画面での確認はできる）
#   SYSTEM_ALERT_AFTER_MIN  : worker・スケジューラー・Redis の停止がこの分数続いたら通知する
#   SYSTEM_STALE_DAYS       : この日数以上収集できていない有効な機器を警告する（0 で確認しない）
SYSTEM_WATCHDOG_ENABLED=true
SYSTEM_ALERT_AFTER_MIN=10
SYSTEM_STALE_DAYS=7

# コンプライアンスの正規表現の照合にかけられる時間（1回の評価＝ルール × 機器 あたりの秒数）
COMPLIANCE_REGEX_TIMEOUT=2

# アクティビティログ（収集の結果・違反の発生など、システムで起きたこと）
#   ACTIVITY_LOG_RETENTION_DAYS : 保持日数（0 なら削除しない）
#   ACTIVITY_LOG_UNCHANGED      : 収集で変更が無かったときも記録するか（false で変更あり・失敗などだけ）
ACTIVITY_LOG_RETENTION_DAYS=90
ACTIVITY_LOG_UNCHANGED=true

# Ping監視
#   PING_TIMEOUT     : 1回の PING の応答待ち（秒）。監視間隔より長い場合は間隔に合わせて短くなります
#   PING_MAX_TARGETS : 1画面で同時に監視できる対象数の上限
PING_TIMEOUT=1
PING_MAX_TARGETS=300

# モニタリング（試験導入。帯域の使用率・FW ルールのヒット数）
#   MONITORING_ENABLED      : true で画面・定期取得を有効にする（変更後は setup.sh でコンテナを作り直す）
#   MONITOR_INTERVAL_SEC    : SNMP で帯域を取得する間隔（秒）
#   MONITOR_RETENTION_DAYS  : 帯域の記録の保存日数
#   MONITOR_FW_INTERVAL_MIN : FW のルールのヒット数を取得する間隔（分。SSH でログインして取得）
#   MONITOR_PANOS_VSYS      : Palo Alto でヒット数を取得する vsys
MONITORING_ENABLED=false
MONITOR_INTERVAL_SEC=300
MONITOR_RETENTION_DAYS=30
MONITOR_FW_INTERVAL_MIN=60
MONITOR_PANOS_VSYS=vsys1

# 利用者がブラウザで開く URL（例: https://192.168.1.10 / https://netconfig.example.local）
# コンフィグ変更の通知（Discord / Slack）に画面へのリンクを付けるのに使う。空ならリンクなし
# setup.sh・import_cert.sh が未設定のときに IP アドレスから自動で設定します
PUBLIC_URL=

# 別オリジンからAPIを呼ぶ場合のみ設定（カンマ区切り）。通常は空でよい
ALLOWED_ORIGINS=

# 本番構成で公開する HTTP ポート
HTTP_PORT=80
# 本番構成で公開する HTTPS ポート（certs/ に証明書があるときだけ使われる。scripts/import_cert.sh 参照）
HTTPS_PORT=443

# バックアップ（scripts/backup.sh。setup.sh が systemd タイマーで毎日実行するよう登録）
# 保存先（サーバーの外のディスク・NFS などを推奨）
BACKUP_DIR=/var/backups/netconfig-manager
# 保存日数
BACKUP_KEEP_DAYS=14
# 実行時刻（systemd の OnCalendar 形式。off で無効。変更後は setup.sh を実行）
BACKUP_ON_CALENDAR=*-*-* 03:15:00
# ターミナルの記録も含める
BACKUP_TERMINAL_LOGS=true
